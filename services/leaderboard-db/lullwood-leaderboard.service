# LUL-3264: leaderboard + stats SQLite service (services/leaderboard-db/).
#
# A SYSTEM unit running as its own user, not a `systemd --user` unit: on this
# Ubuntu box (kernel.apparmor_restrict_unprivileged_userns=1) the user manager
# silently ignores ProtectHome/BindPaths, so a user unit would run with full
# read access to ~/.lullwood (deploy key, GitHub token) and the Paperclip data.
# Verified 2026-10-02 -- docs/specs/lul-3264-leaderboard-security.md, H2.
#
# Installed by install.sh (needs sudo, once). Public path: Tailscale Funnel ->
# 127.0.0.1:8787. Agents read the hourly snapshot through the shared group.
[Unit]
Description=Lullwood leaderboard + stats service (SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lullwood-lb
Group=lullwood-lb
ExecStart=/usr/bin/node /opt/lullwood-leaderboard/app/services/leaderboard-db/server.ts
EnvironmentFile=/etc/lullwood-leaderboard/env
Environment=LB_DB_PATH=/var/lib/lullwood-leaderboard/data/leaderboard.db
Environment=LB_SNAPSHOT_PATH=/var/lib/lullwood-leaderboard/snapshot/stats.db
Environment=LB_PORT=8787
Environment=NODE_ENV=production
StateDirectory=lullwood-leaderboard lullwood-leaderboard/data lullwood-leaderboard/snapshot
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=5

# Resource ceilings -- this box also runs Paperclip, Postgres and Playwright.
MemoryMax=256M
MemorySwapMax=0
TasksMax=64
CPUQuota=50%
Nice=5

# Sandbox: no /home at all, read-only OS, its own /tmp, no privilege gain.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/lullwood-leaderboard
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# node's JIT needs W+X pages, so MemoryDenyWriteExecute stays off.

[Install]
WantedBy=multi-user.target
